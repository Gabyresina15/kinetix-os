{
  "name": "kinetix-os",
  "version": "1.0.0",
  "description": "Kinetix OS — Autonomous Spatial ERP & Warehouse Ledger Orchestrator powered by Meta AI (Muse Spark Open, SAM 3.1, Muse Code, Muse Image, Muse Voice)",
  "main": "dist/server.js",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "tsx src/scripts/devRunner.ts",
    "replay": "tsx src/scripts/devRunner.ts --replay",
    "build": "tsc && npm --prefix client run build",
    "reset": "tsx src/scripts/resetLedger.ts",
    "test": "tsx --test src/__tests__/kinetix.test.ts",
    "server:dev": "tsx watch src/server.ts",
    "server:replay": "tsx src/scripts/startReplay.ts",
    "client:dev": "npm --prefix client run dev",
    "start": "tsx src/server.ts",
    "seed": "tsx src/scripts/seedDb.ts",
    "test:stream": "curl -N -X POST http://localhost:4000/api/orchestrate-stream"
  },
  "keywords": [
    "kinetix",
    "spatial-erp",
    "muse-spark-open",
    "sam-3.1",
    "muse-image",
    "muse-code",
    "muse-voice",
    "quickjs-wasm",
    "meta-hackathon"
  ],
  "author": "Gabriel Sebastián Resina Barrientos",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "mongodb": "^7.7.0",
    "quickjs-emscripten": "^0.31.0",
    "sharp": "^0.35.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
