# ============================================================================
# KINETIX OS - CORE ORCHESTRATOR CONFIG
# ============================================================================
PORT=4000
# Modes:
# LIVE   -> Calls Baseten (Muse Spark Open) + Meta Model API (Muse Voice, SAM 3.1, Muse Image, Muse Wonder) live
# REPLAY -> Deterministic replay from fixtures/golden-path/golden-spark-replay.json (zero API keys required)
ORCHESTRATOR_MODE=LIVE

# Optional MongoDB connection string (falls back to data/ledger/*.json if unavailable)
MONGO_URI=mongodb://127.0.0.1:27017/kinetix_erp

# Optional API token guard if exposing LIVE mode publicly
KINETIX_LIVE_TOKEN=

# ============================================================================
# 1. BASETEN SERVERLESS GPU (Open-Weights Track: Muse Spark Open)
# ============================================================================
BASETEN_API_KEY=your_baseten_api_key_here
BASETEN_BASE_URL=https://inference.baseten.co/v1
# Exact hackathon Open-Weights model identifier required by Baseten
BASETEN_MODEL=meta-models/muse-spark-open-1026

# ============================================================================
# 2. OFFICIAL META MODEL API (SAM 3.1 / Muse Image / Muse Wonder / Muse Spark)
# ============================================================================
META_MODEL_API_KEY=your_meta_model_api_key_here
META_API_BASE_URL=https://api.meta.ai/v1
META_SAM_URL=https://api.meta.ai/v1/responses
META_SAM_MODEL=sam-3.1
META_IMAGE_MODEL=muse-image-1.0
META_IMAGE_SIZE=1024x1024
META_CODE_MODEL=muse-wonder-1.0
META_SPARK_MODEL=muse-spark-1.3
META_VOICE_MODEL=muse-voice-transcribe-1.0

# ============================================================================
# 3. EXTERNAL ZERO-TRUST DISPATCH WEBHOOK (OPTIONAL)
# ============================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
