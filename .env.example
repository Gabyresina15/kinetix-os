# ============================================================================
# KINETIX OS - CORE ORCHESTRATOR CONFIG
# ============================================================================
PORT=4000
# Modos:
# LIVE   -> Llama a Baseten + Meta API en vivo, guarda fixtures en disco y cae a fallback si hay timeout
# REPLAY -> Lee de fixtures/golden-path o fallback con latencia simulada (ideal para grabar video sin gastar créditos)
ORCHESTRATOR_MODE=LIVE

# ============================================================================
# 1. BASETEN SERVERLESS GPU (Open-Weights Track + Vision + Always-On Reasoning)
# ============================================================================
BASETEN_API_KEY=pega_aqui_tu_key_de_baseten
BASETEN_BASE_URL=https://inference.baseten.co/v1
# IMPORTANTE: Usar exactamente este nombre de modelo de la hackathon
BASETEN_MODEL=meta-models/muse-spark-open-1026

# ============================================================================
# 2. META MODEL API OFICIAL (Muse Spark / Muse Image / Muse Code / SAM 3.1 / Voice)
# ============================================================================
META_MODEL_API_KEY=pega_aqui_tu_key_de_meta_api
META_API_BASE_URL=https://api.llama.com/v1
META_SPARK_MODEL=muse-spark
META_IMAGE_MODEL=muse-image
META_CODE_MODEL=muse-code
META_SAM_MODEL=sam-3.1
META_VOICE_MODEL=voice-transcribe

# ============================================================================
# 3. INTEGRACIONES OPCIONALES (Notificación Externa en Vivo para el Video)
# ============================================================================
# Si querés que te suene el teléfono en vivo durante el video cuando se aprueba el reclamo:
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
