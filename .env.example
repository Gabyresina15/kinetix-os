PORT=4000
# Modos: LIVE (llama a Baseten/Meta en vivo y guarda caché) | REPLAY (usa fixtures instantáneos)
ORCHESTRATOR_MODE=LIVE

# 1. BASETEN (Open-Weights Multimodal + Reasoning Engine)
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026

# 2. META MODEL API OFICIAL (Suite Complementaria: Spark / Image / Code / SAM)
META_MODEL_API_KEY=
META_API_BASE_URL=https://api.llama.com/v1
